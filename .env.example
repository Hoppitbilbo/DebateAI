# ---- Server ----
PORT=8080
# Where the SQLite database and the generated secret live (mount a volume here).
DATA_DIR=./data
# Public address used in e-mail links (invites, password reset).
PUBLIC_URL=http://localhost:8080
# Secret used to encrypt API keys stored in the database. If empty, one is
# generated in DATA_DIR/secret.key - back it up together with the database.
APP_SECRET=

# ---- First administrator (optional) ----
# If set, the admin is created on first start; otherwise open the site and
# follow the setup page.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- AI providers (optional bootstrap) ----
# Providers are normally added from Admin → AI & JEV. These variables only
# pre-configure them on the very first start.
# Google AI Studio key (free tier; also enables the Gemini Live voice mode).
GEMINI_API_KEY=
# OpenCode key: adds OpenCode Zen (free models such as big-pickle) and the
# Jev judge (jev-1.13-free) used to check teachers' assignments.
OPENCODE_API_KEY=

# ---- E-mail (optional, can also be set in Admin → Settings) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | tls | none
SMTP_SECURITY=starttls
