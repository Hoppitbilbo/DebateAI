# ---- Server ----
PORT=8080
# Where the SQLite database and the generated secret live. Ignored by
# docker compose, which always uses the /data volume.
DATA_DIR=./data
# Public address used in e-mail links (invites, password reset).
PUBLIC_URL=http://localhost:8080
# Secret used to encrypt API keys stored in the database. If empty, one is
# generated in DATA_DIR/secret.key - back it up together with the database.
APP_SECRET=

# ---- First administrator (optional) ----
# If set, the admin is created on first start; otherwise open the site and
# follow the setup page.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- AI providers (optional bootstrap) ----
# Providers are normally added from Admin → AI & JEV. These variables only
# pre-configure them on the very first start.
# OpenRouter key: hundreds of models, many free (":free"). Used for chat,
# evaluations and as fallback judge (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# TypeSafe key: the Jev judge that checks teachers' assignments
# (https://console.typesafe.ai).
TYPESAFE_API_KEY=
# Google AI Studio key: needed for the Gemini Live voice mode
# (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# OpenCode key (optional): OpenCode Zen free models and the free Jev judge.
OPENCODE_API_KEY=

# ---- E-mail (optional, can also be set in Admin → Settings) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | tls | none
SMTP_SECURITY=starttls
